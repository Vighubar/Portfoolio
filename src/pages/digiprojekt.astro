---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Digiprojekt2 — Design">
  <div class="design-container">
    <svg class="landscape-svg" viewBox="0 0 1024 576" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <!-- Sky background -->
      <rect width="1024" height="576" fill="#B3D9FF"/>
      
      <!-- Sun -->
      <circle cx="650" cy="100" r="40" fill="#F4E4A6"/>
      
      <!-- Clouds -->
      <g id="cloud">
        <ellipse cx="85" cy="85" rx="35" ry="25" fill="#FFFFFF"/>
        <ellipse cx="115" cy="75" rx="30" ry="22" fill="#FFFFFF"/>
        <ellipse cx="55" cy="75" rx="28" ry="20" fill="#FFFFFF"/>
      </g>
      
      <g id="cloud2">
        <ellipse cx="520" cy="70" rx="35" ry="25" fill="#FFFFFF"/>
        <ellipse cx="550" cy="60" rx="30" ry="22" fill="#FFFFFF"/>
        <ellipse cx="490" cy="60" rx="28" ry="20" fill="#FFFFFF"/>
      </g>
      
      <!-- Sailboat -->
      <g id="sailboat">
        <!-- Mast -->
        <line x1="280" y1="50" x2="280" y2="150" stroke="#8B7355" stroke-width="3"/>
        <!-- Hull -->
        <ellipse cx="280" cy="160" rx="35" ry="20" fill="#8B7355"/>
        <!-- Sail -->
        <polygon points="280,60 280,140 350,100" fill="#6B4C9A"/>
        <!-- Flag -->
        <polygon points="280,50 290,40 290,65" fill="#6B4C9A"/>
      </g>
      
      <!-- Green grass/landscape -->
      <rect y="200" width="1024" height="376" fill="#6BC98E"/>
      
      <!-- River/water path - winding curves -->
      <path d="M 0 280 Q 200 250, 350 320 T 700 350 T 1024 400" stroke="#7B9FD4" stroke-width="120" fill="none"/>
      <path d="M 0 320 Q 200 290, 350 360 T 700 390 T 1024 440" stroke="#8BA5D4" stroke-width="80" fill="none"/>
      
      <!-- Trees -->
      <!-- Tree 1 (left) -->
      <g id="tree1">
        <ellipse cx="160" cy="320" rx="45" ry="50" fill="#4D7A5E"/>
        <polygon points="160,380 130,350 190,350" fill="#A0826D"/>
      </g>
      
      <!-- Tree 2 (center-left) -->
      <g id="tree2">
        <ellipse cx="420" cy="290" rx="50" ry="55" fill="#4D7A5E"/>
        <polygon points="420,360 385,325 455,325" fill="#A0826D"/>
      </g>
      
      <!-- Tree 3 (right) -->
      <g id="tree3">
        <ellipse cx="720" cy="280" rx="50" ry="55" fill="#4D7A5E"/>
        <polygon points="720,350 685,315 755,315" fill="#A0826D"/>
      </g>
      
      <!-- Tree 4 (bottom right) -->
      <g id="tree4">
        <ellipse cx="650" cy="420" rx="45" ry="50" fill="#4D7A5E"/>
        <polygon points="650,480 620,450 680,450" fill="#A0826D"/>
      </g>
      
      <!-- Location labels with backgrounds -->
      <!-- IDEE label -->
      <g id="idee-label">
        <rect x="100" y="240" width="70" height="45" rx="8" fill="#E8C5B4" opacity="0.9"/>
        <text x="135" y="272" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#333333" text-anchor="middle">IDEE</text>
      </g>
      
      <!-- UUIRIME label -->
      <g id="uuirime-label">
        <rect x="465" y="160" width="120" height="50" rx="8" fill="#D67C5C" opacity="0.95"/>
        <text x="525" y="175" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#FFFFFF" text-anchor="middle">UUIRIME</text>
        <text x="525" y="198" font-family="Arial, sans-serif" font-size="11" fill="#FFFFFF" text-anchor="middle">
          <tspan x="525">info tarvtud kasutatav viiditestada</tspan>
          <tspan x="525" dy="15">28:00 iamplustegehtus</tspan>
          <tspan x="525" dy="15">28:00 kanale rohkem infode</tspan>
        </text>
      </g>
    </svg>
    
    <!-- Sidebar -->
    <aside class="design-diary">
      <h2>Design diary</h2>
      <p>13:49- tegin mockupi</p>
    </aside>
  </div>
</Layout>

<style>
  .design-container {
    display: flex;
    width: 100%;
    height: 100vh;
    background: #f5f5f5;
  }
  
  .landscape-svg {
    flex: 1;
    background: linear-gradient(to bottom, #B3D9FF 0%, #6BC98E 35%);
  }
  
  .design-diary {
    width: 280px;
    background-color: #A69060;
    padding: 32px 24px;
    box-shadow: -4px 0 12px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  
  .design-diary h2 {
    font-family: 'Arial', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
  }
  
  .design-diary p {
    font-family: 'Arial', sans-serif;
    font-size: 14px;
    color: #F5F5F5;
    margin: 0;
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    .design-container {
      flex-direction: column;
    }
    
    .design-diary {
      width: 100%;
      padding: 24px;
    }
  }
</style>
