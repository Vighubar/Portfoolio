<style>
  .about-page {
    min-height: 100vh;
    background-color: #e4e3eb;
    position: relative;
    overflow: hidden;
  }

  /* SVG covers the full page — nav to footer */
  .constellation-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Diagonal drift — tile is 1440×900 (matches viewBox).
     Copy layers start at -1440,-900 so there's always coverage. */
  @keyframes drift {
    from { transform: translate(0px,   0px);   }
    to   { transform: translate(1440px, 900px); }
  }

  .star-layer-a      { animation: drift 90s linear infinite; }
  .star-layer-a-copy { animation: drift 90s linear infinite;
                       transform: translate(-1440px, -900px); }

  .star-layer-b      { animation: drift 65s linear infinite; }
  .star-layer-b-copy { animation: drift 65s linear infinite;
                       transform: translate(-1440px, -900px); }

  .star-layer-c      { animation: drift 45s linear infinite; }
  .star-layer-c-copy { animation: drift 45s linear infinite;
                       transform: translate(-1440px, -900px); }

  .about-main {
    max-width: 1440px;
    margin: 0 auto;
    padding: 156px 58px 80px;
    position: relative;
    z-index: 1;
  }

  /* Push all direct children above the SVG */
  .about-title,
  .about-layout {
    position: relative;
    z-index: 1;
  }

  .about-title {
    font-family: 'Carter One', sans-serif;
    font-size: 36px;
    color: #000;
    line-height: 1;
    margin-bottom: 80px;
  }

  .about-layout {
    display: flex;
    flex-direction: row;
    gap: 60px;
    align-items: flex-start;
  }

  /* Q&A column */
  .qa-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }

  .qa-pair {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .qa-question {
    background-color: #7863BC;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    min-height: 64px;
  }

  .qa-question p {
    font-family: 'Carter One', sans-serif;
    font-size: 20px;
    color: #EFEEF6;
    line-height: 1.4;
    margin: 0;
  }

  .qa-answer {
    background-color: #AD9ED4;
    padding: 16px 20px;
    display: flex;
    align-items: flex-start;
    min-height: 64px;
    margin-left: 40px;
  }

  .qa-answer p {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 20px;
    color: #000;
    line-height: 1.6;
    margin: 0;
  }

  /* Blinking cursor appended while typing */
  .answer-text.typing::after {
    content: '|';
    display: inline-block;
    animation: blink 0.7s step-end infinite;
    color: #483A74;
    font-weight: 400;
    margin-left: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* Portrait */
  .about-portrait {
    flex-shrink: 0;
    width: 587px;
  }

  .portrait-frame {
    border: 20px solid #483A74;
    overflow: hidden;
    height: 783px;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .about-layout { flex-direction: column; }
    .about-portrait { width: 100%; }
    .portrait-frame { height: auto; }
    .qa-answer { margin-left: 0; }
  }
</style>

<script>
  // Typewriter — questions are already visible, answers type out sequentially
  const answers = document.querySelectorAll<HTMLElement>('.qa-answer');

  // Typing speed (ms per character) and pause between pairs
  const CHAR_DELAY   = 22;
  const PAIR_PAUSE   = 500;  // wait after each answer finishes before starting next
  const START_DELAY  = 400;  // initial pause before first answer starts

  function typeAnswer(el: HTMLElement, text: string): Promise<void> {
    return new Promise(resolve => {
      const p = el.querySelector<HTMLElement>('.answer-text')!;
      p.classList.add('typing');
      let i = 0;

      const tick = () => {
        if (i <= text.length) {
          p.textContent = text.slice(0, i);
          i++;
          setTimeout(tick, CHAR_DELAY);
        } else {
          p.classList.remove('typing');
          resolve();
        }
      };
      tick();
    });
  }

  async function runSequence() {
    await new Promise(r => setTimeout(r, START_DELAY));
    for (const answerEl of Array.from(answers)) {
      const text = (answerEl as HTMLElement).dataset.answer ?? '';
      await typeAnswer(answerEl as HTMLElement, text);
      await new Promise(r => setTimeout(r, PAIR_PAUSE));
    }
  }

  runSequence();
</script>
