---
import Layout from "../layouts/Layout.astro";

const imgPulss   = "/project-pulss.png";
const imgOct31   = "/project-oct31.png";
const imgBrand   = "/project-brand.png";
const imgFrame20 = "/project-frame20.png";
---

<Layout title="Projects — Kelly-Leontine Merilo">
  <div class="projects-page">

    <!-- Star background — large graphic outlined stars, editorial twist on about's scattered field -->
    <svg
      class="star-bg"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <path id="star5" d="M0,-1 L0.224,-0.309 L0.951,-0.309 L0.363,0.118 L0.588,0.809 L0,0.382 L-0.588,0.809 L-0.363,0.118 L-0.951,-0.309 L-0.224,-0.309 Z"/>
      </defs>

      <!-- Huge ghost star — top-left bleed, outline only -->
      <use href="#star5" transform="translate(-60, 120) scale(200)"
           fill="none" stroke="#7863BC" stroke-width="0.018" opacity="0.55"/>

      <!-- Large filled star — top-right corner -->
      <use href="#star5" transform="translate(1380, 60) scale(130)"
           fill="#AD9ED4" stroke="none" opacity="0.45"/>

      <!-- Medium outline star — mid-left -->
      <use href="#star5" transform="translate(180, 520) scale(90)"
           fill="none" stroke="#483A74" stroke-width="0.022" opacity="0.60"/>

      <!-- Small solid accent — bottom-right -->
      <use href="#star5" transform="translate(1300, 820) scale(55)"
           fill="#7863BC" stroke="none" opacity="0.55"/>

      <!-- Crisp outline star — center-right -->
      <use href="#star5" transform="translate(1100, 380) scale(28)"
           fill="none" stroke="#483A74" stroke-width="0.04" opacity="0.70"/>

      <!-- Solid accent — bottom-left corner -->
      <use href="#star5" transform="translate(90, 830) scale(22)"
           fill="#483A74" stroke="none" opacity="0.65"/>

      <!-- Slow-spinning outline star — bottom-center -->
      <use href="#star5" transform="translate(780, 950) scale(160)"
           fill="none" stroke="#7863BC" stroke-width="0.014" opacity="0.40"
           class="star-spin"/>
    </svg>

    <main class="projects-main">

      <!-- More design section -->
      <section aria-labelledby="more-design-heading">
        <h2 id="more-design-heading" class="section-title-lg">More design</h2>

        <!-- Featured layout: 1 large + 2 small stacked -->
        <div class="grid-featured">
          <div class="thumb-card featured">
            <img src={imgPulss} alt="PULSS festival" />
          </div>
          <div class="thumb-card">
            <img src={imgOct31} alt="October 31 game" />
          </div>
          <div class="thumb-card brand-bg">
            <img src={imgBrand} alt="Brand identity" />
          </div>
        </div>

        <!-- Secondary row: wider cards -->
        <div class="grid-secondary">
          <div class="thumb-card-wide">
            <img src={imgFrame20} alt="Under construction" />
          </div>
          <div class="thumb-card-wide">
            <img src={imgFrame20} alt="Under construction" />
          </div>
        </div>
      </section>

      <!-- Passion projects section -->
      <section class="passion-section" aria-labelledby="passion-heading">
        <h2 id="passion-heading" class="section-title-sm">Some passion projects</h2>

        <div class="grid-secondary">
          <div class="thumb-card-wide">
            <img src={imgFrame20} alt="Under construction" />
          </div>
          <div class="thumb-card-wide">
            <img src={imgFrame20} alt="Under construction" />
          </div>
        </div>
      </section>

    </main>

  </div>
</Layout>

<style>
  .projects-page {
    min-height: 100vh;
    background-color: #d8d5e8;
    position: relative;
    overflow: hidden;
  }

  /* Full-page SVG sits behind everything */
  .star-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Slow rotation on the bottom-center star */
  @keyframes spin-slow {
    from { transform: translate(780px, 950px) scale(160) rotate(0deg); }
    to   { transform: translate(780px, 950px) scale(160) rotate(360deg); }
  }

  .star-spin {
    transform-origin: 780px 950px;
    animation: spin-slow 60s linear infinite;
  }

  .projects-main {
    max-width: 1440px;
    margin: 0 auto;
    padding: 137px 69px 80px;
    position: relative;
    z-index: 1;
  }

  .section-title-lg {
    font-family: 'Carter One', sans-serif;
    font-size: 36px;
    color: #000;
    line-height: 1;
    margin-bottom: 48px;
  }

  .section-title-sm {
    font-family: 'Carter One', sans-serif;
    font-size: 24px;
    color: #000;
    line-height: 1;
    margin-bottom: 32px;
  }

  /* Featured grid: large card spanning 2 rows on the left, 2 smaller cards stacked on the right */
  .grid-featured {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .grid-featured .thumb-card.featured {
    grid-row: 1 / 3;
    height: 100%;
    min-height: 480px;
  }

  .thumb-card {
    overflow: hidden;
    background: #fff;
  }

  .thumb-card:not(.featured) {
    height: 232px;
  }

  .thumb-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-card.brand-bg {
    background-color: #a4e5f2;
  }

  /* Secondary 2-column grid */
  .grid-secondary {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 16px;
  }

  .thumb-card-wide {
    height: 311px;
    overflow: hidden;
    background: #fff;
  }

  .thumb-card-wide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Passion section */
  .passion-section {
    margin-top: 80px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid-featured {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .grid-featured .thumb-card.featured {
      grid-row: auto;
      min-height: 280px;
    }
    .thumb-card:not(.featured) {
      height: 200px;
    }
    .grid-secondary {
      grid-template-columns: 1fr;
    }
    .thumb-card-wide {
      height: 220px;
    }
  }
</style>
