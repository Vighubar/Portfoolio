---
import Layout from "../layouts/Layout.astro";
---

<Layout title="More Projects — Kelly-Leontine Merilo">
  <div class="projects-page">
    <div class="projects-header">
      <h1>More Projects</h1>
      <p>A collection of additional work beyond the main portfolio pieces.</p>
    </div>

    <div class="projects-grid">
      <!-- Arduino MX5 Project Card -->
      <article class="project-item">
        <a href="/projects/arduino-mx5" class="project-link">
          <div class="project-image-wrap">
            <img
              src="/miot-left.png"
              alt="Arduino MX5 Miata Coaster"
              class="project-image"
            />
          </div>
          <div class="project-info">
            <h2 class="project-title">Arduino MX5</h2>
            <p class="project-description">
              A 3D printed model of a Mazda MX5, built around an Arduino brain. Place something on top of it and the headlights pop up while RGB lights switch on.
            </p>
            <div class="project-tags">
              <span class="project-tag">Arduino</span>
              <span class="project-tag">3D Modelling</span>
              <span class="project-tag">Fusion 360</span>
            </div>
            <span class="project-cta">View case study →</span>
          </div>
        </a>
      </article>
    </div>
  </div>
</Layout>

<style>
  .projects-page {
    background-color: #e4e3eb;
    min-height: 100vh;
    padding-top: 56px;
  }

  .projects-header {
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 58px 60px;
    text-align: center;
  }

  .projects-header h1 {
    font-family: 'Carter One', sans-serif;
    font-size: 48px;
    color: #000;
    line-height: 1;
    margin-bottom: 16px;
  }

  .projects-header p {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #483A74;
    line-height: 1.6;
  }

  .projects-grid {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 58px 80px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .project-item {
    position: relative;
    overflow: hidden;
    background: #fff;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(98, 84, 184, 0.2);
  }

  .project-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .project-image-wrap {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .project-item:hover .project-image {
    transform: scale(1.05);
  }

  .project-info {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-title {
    font-family: 'Carter One', sans-serif;
    font-size: 22px;
    color: #000;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .project-description {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #483A74;
    line-height: 1.5;
    margin-bottom: 16px;
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .project-tag {
    font-family: 'Nunito', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7863BC;
    background: rgba(120, 99, 188, 0.1);
    padding: 4px 10px;
  }

  .project-cta {
    font-family: 'Carter One', sans-serif;
    font-size: 13px;
    color: #7863BC;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .project-item:hover .project-cta {
    color: #AD9ED4;
  }

  @media (max-width: 1100px) {
    .projects-header {
      padding: 60px 24px 40px;
    }

    .projects-header h1 {
      font-size: 36px;
    }

    .projects-grid {
      padding: 0 24px 60px;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .projects-header h1 {
      font-size: 28px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
