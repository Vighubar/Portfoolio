---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="PULSS — Kelly-Leontine Merilo">
  <div class="cs-wrap">

    <!-- ── PAGE TITLE ── -->
    <div class="cs-top">
      <h1 class="cs-title">PULSS</h1>
      <p class="cs-sub">Charity Youth Festival Website</p>
    </div>

    <!-- ── SPLIT LAYOUT ── -->
    <div class="cs-split">

      <!-- LEFT: image panel -->
      <div class="cs-left">
        <div class="cs-img-wrap cs-img-empty">
          <span class="cs-img-placeholder">Image coming soon</span>
        </div>
        <div class="cs-img-caption" id="cs-caption"></div>
      </div>

      <!-- RIGHT: section list -->
      <div class="cs-right">

        <div class="cs-row">
          <button class="cs-row-btn" aria-expanded="false">
            <span class="cs-row-title">About the Project</span>
            <span class="cs-row-arrow">►</span>
          </button>
          <div class="cs-row-body">
            <p class="cs-body">
              PULSS is an imaginary youth festival in Tallinn with the goal of giving young
              people a chance to actually participate, not just be part of the audience.
              I designed the website in Figma as part of my UI Design 1 course.
            </p>
            <div class="cs-tags">
              <span class="cs-tag">Figma</span>
              <span class="cs-tag">UI/UX Design</span>
              <span class="cs-tag">University project</span>
            </div>
          </div>
        </div>

        <div class="cs-row">
          <button class="cs-row-btn" aria-expanded="false">
            <span class="cs-row-title">The Challenge</span>
            <span class="cs-row-arrow">►</span>
          </button>
          <div class="cs-row-body">
            <p class="cs-body">
              The hardest part was finding the right vibe — something that didn't feel too
              clinical but also not too chaotic, while keeping that charitable feeling intact.
              The red and blue the client provided were challenging since finding shades that
              worked together took a lot of trial and error.
            </p>
          </div>
        </div>

        <div class="cs-row">
          <button class="cs-row-btn" aria-expanded="false">
            <span class="cs-row-title">The Process</span>
            <span class="cs-row-arrow">►</span>
          </button>
          <div class="cs-row-body">
            <p class="cs-body">
              Finding the visual style required a lot of experimentation. I used red as an
              accent color but chose a different color for the CTAs. Dark tones capture the
              feeling of a festival. I also designed a mobile version alongside desktop and
              worked with a design system and reusable components for the first time.
            </p>
          </div>
        </div>

        <div class="cs-row">
          <button class="cs-row-btn" aria-expanded="false">
            <span class="cs-row-title">Registration & Tickets</span>
            <span class="cs-row-arrow">►</span>
          </button>
          <div class="cs-row-body">
            <p class="cs-body">
              Three roles — audience, performer, volunteer. Ticket visuals reinforce the brand
              with the pink gradient and bold PULSS wordmark. The form stays minimal so the
              process feels quick and open to everyone.
            </p>
          </div>
        </div>

        <div class="cs-row">
          <button class="cs-row-btn" aria-expanded="false">
            <span class="cs-row-title">What I Learned</span>
            <span class="cs-row-arrow">►</span>
          </button>
          <div class="cs-row-body">
            <p class="cs-body">
              The schedule section still isn't where I want it to be, but with better references
              it's something I could improve in the future. Working with a real colour system for
              the first time taught me a lot about consistency and reusability in design.
            </p>
            <a
              href="https://www.figma.com/proto/v5nvqOsmZDn97oRbh7aSSH/Pulss?node-id=133-94&t=4hsX65caN3ZD1uSv-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=133%3A94&show-proto-sidebar=1"
              target="_blank"
              rel="noopener noreferrer"
              class="cs-proto-btn"
            >View Prototype →</a>
          </div>
        </div>

      </div>
    </div>

    <!-- ── BACK ── -->
    <div class="cs-back">
      <a href="/#projects" class="cs-back-link">← Back to works</a>
    </div>

  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap');

  .cs-wrap {
    background: #00004C;
    min-height: 100vh;
    padding-top: 56px;
    font-family: 'Oswald', sans-serif;
    color: #fff;
  }

  /* ── top ── */
  .cs-top {
    padding: 56px 72px 40px;
  }

  .cs-title {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: clamp(48px, 8vw, 100px);
    color: #FF315A;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .cs-sub {
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    font-size: clamp(14px, 1.8vw, 20px);
    color: #D7DAFF;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 6px;
  }

  /* ── split ── */
  .cs-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 70vh;
  }

  /* ── left ── */
  .cs-left {
    position: sticky;
    top: 56px;
    height: calc(100vh - 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 48px 0 72px;
    gap: 16px;
  }

  .cs-img-wrap {
    overflow: hidden;
    border: 2px solid rgba(255, 49, 90, 0.35);
    line-height: 0;
  }

  .cs-img-empty {
    aspect-ratio: 16/10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 49, 90, 0.05);
    line-height: 1;
  }

  .cs-img-placeholder {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 49, 90, 0.35);
  }

  .cs-img-caption {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(215, 218, 255, 0.45);
  }

  /* ── right ── */
  .cs-right {
    padding: 0 72px 0 0;
    display: flex;
    flex-direction: column;
  }

  /* ── row ── */
  .cs-row {
    border-bottom: 1px solid rgba(255, 49, 90, 0.2);
  }
  .cs-row:first-child {
    border-top: 1px solid rgba(255, 49, 90, 0.2);
  }

  .cs-row-btn {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 0;
    gap: 16px;
    text-align: left;
  }

  .cs-row-title {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 30px);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }

  .cs-row-btn:hover .cs-row-title,
  .cs-row-btn[aria-expanded="true"] .cs-row-title {
    color: #FF315A;
  }

  .cs-row-arrow {
    width: 44px;
    height: 44px;
    background: #3546FF;
    color: #fff;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.3s;
  }

  .cs-row-btn:hover .cs-row-arrow {
    background: #FF315A;
  }

  .cs-row-btn[aria-expanded="true"] .cs-row-arrow {
    background: #FF315A;
    transform: rotate(90deg);
  }

  /* ── row body ── */
  .cs-row-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
    overflow: hidden;
  }

  .cs-row-body.open {
    grid-template-rows: 1fr;
  }

  .cs-row-body > * {
    overflow: hidden;
  }

  .cs-row-body .cs-body {
    padding-bottom: 28px;
  }

  .cs-body {
    font-family: 'Oswald', sans-serif;
    font-weight: 400;
    font-size: clamp(14px, 1.3vw, 17px);
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.85;
    max-width: 520px;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 28px;
    margin-top: -8px;
  }

  .cs-tag {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D7DAFF;
    border: 1px solid rgba(215, 218, 255, 0.3);
    padding: 4px 12px;
  }

  .cs-proto-btn {
    display: inline-block;
    background: #3546FF;
    color: #fff;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 32px;
    text-decoration: none;
    margin-top: 8px;
    margin-bottom: 28px;
    transition: background 0.2s;
    align-self: flex-start;
    display: inline-block;
  }
  .cs-proto-btn:hover { background: #5566ff; }

  /* ── back ── */
  .cs-back {
    padding: 48px 72px 56px;
    border-top: 1px solid rgba(255, 49, 90, 0.15);
  }

  .cs-back-link {
    font-family: 'Oswald', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(215, 218, 255, 0.4);
    text-decoration: none;
    transition: color 0.2s;
  }
  .cs-back-link:hover { color: #FF315A; }

  /* ── responsive ── */
  @media (max-width: 900px) {
    .cs-top { padding: 40px 24px 28px; }
    .cs-split { grid-template-columns: 1fr; }
    .cs-left {
      position: relative;
      top: 0;
      height: auto;
      padding: 0 24px 32px;
    }
    .cs-right { padding: 0 24px; }
    .cs-back { padding: 40px 24px 48px; }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLElement>('.cs-row');

  rows.forEach(row => {
    const btn = row.querySelector<HTMLButtonElement>('.cs-row-btn')!;
    const body = row.querySelector<HTMLElement>('.cs-row-body')!;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // close all
      rows.forEach(r => {
        r.querySelector<HTMLButtonElement>('.cs-row-btn')!.setAttribute('aria-expanded', 'false');
        r.querySelector<HTMLElement>('.cs-row-body')!.classList.remove('open');
      });

      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        body.classList.add('open');
      }
    });
  });
</script>
