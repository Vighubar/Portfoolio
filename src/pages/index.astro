---
import Layout from "../layouts/Layout.astro";

const imgPulss  = "/project-pulss.png";
const imgOct31  = "/project-oct31.png";
const imgBrand  = "/project-brand.png";
---

<Layout title="Kelly-Leontine Merilo — Portfolio 2026">

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section
    class="hero-section"
    aria-label="Hero"
  >

    <!-- Interactive scatter stars canvas -->
    <canvas class="scatter-stars" aria-hidden="true"></canvas>

    <!-- Hero star image -->
    <div class="hero-stars" aria-hidden="true">
      <img src="/hero-stars.png" alt="" class="star-img" />
    </div>

    <!-- Hero text block -->
    <div class="hero-content">
      <h1 class="hero-name">Kelly-Leontine<br />Merilo</h1>
      <div class="hero-sub">
        <p class="hero-tagline">Rising star of the design world</p>
        <p class="hero-role">Product designer, indie game developer and more</p>
      </div>
    </div>

  </section>

  <!-- ── WORKS ─────────────────────────────────────────────── -->
  <section
    id="projects"
    class="works-section"
    aria-labelledby="works-heading"
  >
    <div class="works-inner">
      <h2 id="works-heading" class="section-title-lg">My works</h2>

      <div class="projects-list">

        <!-- Project 1: PULSS -->
        <article class="project-card">
          <div class="split-reveal">
            <div class="split-half split-left">
              <img src="/pulss-left.png" alt="PULSS festival project" />
            </div>
            <div class="split-center">
              <p class="split-title">PULSS</p>
              <p class="split-desc">
                Pulss is an imaginary charity music festival where the stage is open to everyone. Designed for young adults who want more than just watching from the crowd. Built in Figma for university, covering everything from the landing page to artist registration and event timetables. The tricky part was keeping it feel fun and accessible while still taking the charity side seriously.
              </p>
              <a href="/projects/pulss" class="split-btn">View case study</a>
            </div>
            <div class="split-half split-right">
              <img src="/pulss-right.png" alt="" aria-hidden="true" />
            </div>
          </div>
        </article>

        <!-- Project 2: October 31 -->
        <article class="project-card">
          <div class="split-reveal">
            <div class="split-half split-left">
              <img src="/oct31-left.png" alt="October 31 game project" />
            </div>
            <div class="split-center">
              <p class="split-title">October 31.</p>
              <p class="split-desc">
                What if one mistake was all it took for your entire friend group to turn on you? October 31st is a point-and-click horror mystery where you have to find a way to help Jane and defeat her darkest demons. Built in Unity as a university project, the game features a full dialogue system, multi-scene navigation, and branching endings that depend on how carefully you've been paying attention.
              </p>
              <a href="/projects/october-31" class="split-btn">View case study</a>
            </div>
            <div class="split-half split-right">
              <img src="/oct31-right.png" alt="" aria-hidden="true" />
            </div>
          </div>
        </article>

        <!-- Project 3: Arduino Miata -->
        <article class="project-card">
          <div class="split-reveal">
            <div class="split-half split-left">
              <img src="/miot-left.png" alt="Arduino Miata MX5 coaster" />
            </div>
            <div class="split-center">
              <p class="split-title">Arduino MX5</p>
              <p class="split-desc">
                The Miata Coaster is a 3D printed model of a Mazda MX5, built around an Arduino brain. Place something on top of it and the headlights pop up while RGB lights switch on across the front, back and underneath. Built solo during an Arduino course to learn soldering, coding and 3D modelling in Fusion 360 from scratch. Still a work in progress.
              </p>
              <a href="/projects/arduino-mx5" class="split-btn">View case study</a>
            </div>
            <div class="split-half split-right">
              <img src="/miot-right.png" alt="" aria-hidden="true" />
            </div>
          </div>
        </article>

      </div>

      <!-- More projects button -->
      <div class="more-btn-wrap">
        <a href="/projects" class="more-btn">More projects</a>
      </div>
    </div>
  </section>

</Layout>

<style>
