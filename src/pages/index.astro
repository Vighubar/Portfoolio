      radial-gradient(2px 2px at 93% 18%, #fff, transparent),
      radial-gradient(1px 1px at 33% 72%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 67% 92%, #fff, transparent),
      radial-gradient(1px 1px at 57% 37%, #c9b8ff, transparent),
