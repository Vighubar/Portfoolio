      radial-gradient(1px 1px at 37% 97%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 63% 17%, #fff, transparent),
      radial-gradient(1px 1px at 23% 52%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 83% 47%, #fff, transparent),
      radial-gradient(1px 1px at 53% 87%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 13% 77%, #fff, transparent),
      radial-gradient(1px 1px at 43% 7%,  #c9b8ff, transparent),
      radial-gradient(2px 2px at 73% 37%, #fff, transparent),
      radial-gradient(1px 1px at 27% 57%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 87% 57%, #fff, transparent),
      radial-gradient(1px 1px at 6%  67%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 96% 97%, #fff, transparent),
      radial-gradient(1px 1px at 36% 87%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 66% 67%, #fff, transparent),
      radial-gradient(1px 1px at 56% 47%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 16% 17%, #fff, transparent),
      radial-gradient(1px 1px at 76% 97%, #c9b8ff, transparent),
      #0d0620;
    overflow: hidden;
  }

  .hero-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .scatter-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .star-img {
    position: absolute;
    display: block;
    object-fit: contain;
    left: 28%;
    top: 10%;
    width: 44%;
    height: auto;
  }

  /* All text positioned absolutely to match Figma exactly */
  .hero-content {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .hero-name {
    position: absolute;
    font-family: 'Shrikhand', serif;
    font-style: italic;
    font-size: clamp(32px, 6.5vw, 94px);
    color: #fff;
    line-height: 1;
    left: 23%;
    top: 43%;
    width: 70%;
    pointer-events: auto;
  }

  .hero-sub {
    position: absolute;
    left: 57%;
    top: 60%;
    pointer-events: auto;
  }

  .hero-tagline {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: clamp(11px, 1vw, 15px);
    color: #fff;
    line-height: 1;
    white-space: nowrap;
  }

  .hero-role {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: clamp(14px, 1.5vw, 20px);
    color: #fff;
    line-height: 1;
    margin-top: 10px;
    white-space: nowrap;
  }

  .hero-year {
    position: absolute;
    left: 3%;
    bottom: 5%;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: clamp(14px, 1.5vw, 20px);
    color: #fff;
    pointer-events: auto;
  }

  /* ── WORKS ── */
  .works-section {
    width: 100%;
    background-color: #e4e3eb;
    padding: 64px 0;
  }

  .works-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 58px;
  }

  .section-title-lg {
    font-family: 'Carter One', sans-serif;
    font-size: 36px;
    color: #000;
    line-height: 1;
    margin-bottom: 48px;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  /* ── PROJECT CARDS — split image reveal ── */

  .project-card {
    height: 409px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    box-shadow: 0 0 0 rgba(98, 84, 184, 0);
    transition: box-shadow 0.4s ease;
  }

  .project-card:hover {
    box-shadow: 0 0 32px rgba(98, 84, 184, 0.45);
  }

  /* The container that holds both halves + center text */
  .split-reveal {
    position: relative;
    width: 100%;
    height: 100%;
    background: #1a1030;
    display: flex;
  }

  .split-half {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.77, 0, 0.18, 1);
    z-index: 2;
  }

  .split-left  { left: 0; }
  .split-right { left: 50%; }

  .brand-cover {
    background-color: #a4e5f2;
  }

  /* Each half shows its own image fully */
  .split-left img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .split-right img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* On hover: left slides left, right slides right */
  .project-card:hover .split-left  { transform: translateX(-100%); }
  .project-card:hover .split-right { transform: translateX(100%);  }

  /* Center text — revealed as halves part */
  .split-center {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 60px;
    opacity: 0;
    transform: scale(0.97);
    transition:
      opacity 0.35s ease 0.25s,
      transform 0.45s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
  }

  .project-card:hover .split-center {
    opacity: 1;
    transform: scale(1);
  }

  .split-title {
    font-family: 'Carter One', sans-serif;
    font-size: 36px;
    color: #EFEEF6;
    line-height: 1;
    margin-bottom: 20px;
    border-bottom: 3px solid #7863BC;
    padding-bottom: 16px;
  }

  .split-desc {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #EFEEF6;
    line-height: 1.6;
  }

  .split-btn {
    display: inline-block;
    margin-top: 24px;
    background-color: #7863BC;
    color: #EFEEF6;
    font-family: 'Carter One', sans-serif;
    font-size: 18px;
    padding: 10px 28px;
    text-decoration: none;
    pointer-events: auto;
    transition: background-color 0.2s;
  }

  .split-btn:hover {
    background-color: #AD9ED4;
  }

  .coming-soon-text {
    font-family: 'Carter One', sans-serif;
    font-size: 28px;
    color: #c9b8ff;
    letter-spacing: 0.06em;
    margin-top: 8px;
  }

  /* More button */
  .more-btn-wrap {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }

  .more-btn {
    display: inline-block;
    background-color: #483A74;
    padding: 5px 30px;
    font-family: 'Carter One', sans-serif;
    font-size: 36px;
    color: #EFEEF6;
    line-height: 90px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .more-btn:hover {
    background-color: #7863BC;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .hero-section { height: 100svh; min-height: 100svh; }
    .hero-name    { left: 5%; top: 40%; width: 90%;
                    font-size: clamp(28px, 7vw, 60px); }
    .hero-sub     { left: 5%; top: 62%; }
    .hero-role    { margin-top: 8px; white-space: normal; font-size: clamp(14px, 2.5vw, 18px); }
    .hero-tagline { white-space: normal; }
    .hero-year    { bottom: 5%; left: 5%; }
    .star-img { left: 5%; top: 6%; width: 80%; }
  }

  @media (max-width: 1100px) {
    .project-card { height: auto; min-height: 280px; }
    .split-reveal { min-height: 280px; }
    .split-center {
      padding: 24px 28px;
      opacity: 1;
      transform: scale(1);
      background: rgba(26, 16, 48, 0.82);
    }
    .split-half { display: none; }
    .split-title { font-size: 24px; }
    .split-desc  { font-size: 15px; }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.scatter-stars')!;
  const section = canvas.closest('.hero-section') as HTMLElement;
  const ctx = canvas.getContext('2d')!;

  // Resize canvas to match hero section
  function resize() {
    canvas.width  = section.offsetWidth;
    canvas.height = section.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  // Draw a 5-pointed star
  function drawStar(cx: number, cy: number, r: number, opacity: number) {
    const inner = r * 0.45;
    ctx.save();
    ctx.globalAlpha = opacity;
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    for (let i = 0; i < 10; i++) {
      const angle = (Math.PI / 5) * i - Math.PI / 2;
      const radius = i % 2 === 0 ? r : inner;
      const x = cx + Math.cos(angle) * radius;
      const y = cy + Math.sin(angle) * radius;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  interface Star {
    x: number; y: number;
    ox: number; oy: number;   // origin (home position)
    vx: number; vy: number;   // velocity
    r: number;                // radius
    opacity: number;
    twinkleOffset: number;
  }

  const STAR_COUNT = 60;
  const SCATTER_RADIUS = 120;
  const SCATTER_FORCE  = 6;
  const RETURN_SPEED   = 0.06;
  const FRICTION       = 0.82;

  const stars: Star[] = [];
  let mouse = { x: -9999, y: -9999 };

  function initStars() {
    stars.length = 0;
    for (let i = 0; i < STAR_COUNT; i++) {
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      stars.push({
        x, y, ox: x, oy: y,
        vx: 0, vy: 0,
        r: Math.random() * 2.5 + 1,
        opacity: Math.random() * 0.5 + 0.3,
        twinkleOffset: Math.random() * Math.PI * 2,
      });
    }
  }
  initStars();
  window.addEventListener('resize', initStars);

  // Track mouse relative to canvas
  section.addEventListener('mousemove', (e: MouseEvent) => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  });
  section.addEventListener('mouseleave', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  let frame = 0;
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    frame++;

    for (const s of stars) {
      // Scatter from cursor
      const dx = s.x - mouse.x;
      const dy = s.y - mouse.y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      if (dist < SCATTER_RADIUS && dist > 0) {
        const force = (SCATTER_RADIUS - dist) / SCATTER_RADIUS * SCATTER_FORCE;
        s.vx += (dx / dist) * force;
        s.vy += (dy / dist) * force;
      }

      // Spring back to origin
      s.vx += (s.ox - s.x) * RETURN_SPEED;
      s.vy += (s.oy - s.y) * RETURN_SPEED;

      // Friction
      s.vx *= FRICTION;
      s.vy *= FRICTION;

      s.x += s.vx;
      s.y += s.vy;

      // Twinkle
      const twinkle = 0.75 + 0.25 * Math.sin(frame * 0.04 + s.twinkleOffset);

      drawStar(s.x, s.y, s.r, s.opacity * twinkle);
    }

    requestAnimationFrame(animate);
  }
  animate();
</script>
