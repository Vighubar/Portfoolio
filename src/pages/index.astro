      radial-gradient(1px 1px at 80% 10%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 50% 70%, #fff, transparent),
      radial-gradient(1px 1px at 10% 55%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 65% 45%, #fff, transparent),
      radial-gradient(2px 2px at 35% 15%, #fff, transparent),
      radial-gradient(1px 1px at 90% 60%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 5%  80%, #fff, transparent),
      radial-gradient(2px 2px at 75% 85%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 45% 5%,  #fff, transparent),
      radial-gradient(1px 1px at 25% 90%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 60% 25%, #fff, transparent),
      radial-gradient(1px 1px at 15% 40%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 85% 75%, #fff, transparent),
      radial-gradient(1px 1px at 40% 60%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 70% 50%, #fff, transparent),
      radial-gradient(1px 1px at 30% 20%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 55% 95%, #fff, transparent),
      radial-gradient(1px 1px at 95% 35%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 8%  15%, #fff, transparent),
      radial-gradient(1px 1px at 48% 38%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 78% 22%, #fff, transparent),
      radial-gradient(1px 1px at 22% 68%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 62% 78%, #fff, transparent),
      radial-gradient(1px 1px at 38% 48%, #c9b8ff, transparent),
      radial-gradient(1px 1px at 88% 88%, #fff, transparent),
      radial-gradient(1px 1px at 12% 92%, #c9b8ff, transparent),
      radial-gradient(2px 2px at 52% 12%, #fff, transparent),
      radial-gradient(1px 1px at 72% 62%, #c9b8ff, transparent),
